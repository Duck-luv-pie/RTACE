# Copy to deployment/.env. Never commit .env (it is in .gitignore).

# Grafana admin credentials (defaults: admin / admin)
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change-me

# Bearer token for the control API's /enforcement endpoints.
# Leave unset for read-only local development (manual overrides then answer 503).
# RTACE_API_TOKEN=change-me

# Simulator pacing when running under --profile app
# SIM_INTERVAL_SECONDS=0.5
